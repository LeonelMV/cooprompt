# Copy this file to apps/server/.env and run `npm run server` from the project root (Node 24: `nvm use`).

# Port and address the server listens on (0.0.0.0 = reachable from the local network).
PORT=4317
HOST=0.0.0.0

# Data folder (SQLite database + files of the shared workspaces).
# COOPROMPT_DATA_DIR=/Users/you/.cooprompt-server

# Name clients see when they connect.
COOPROMPT_SERVER_NAME=CooPrompt

# Code new email/password accounts must enter. When unset, one is generated and stored in
# COOPROMPT_DATA_DIR/access-code.txt. Empty = no code.
# COOPROMPT_ACCESS_CODE=123456

# false disables email/password accounts (Google only): existing password accounts then sign in
# with Google using the same email.
COOPROMPT_PASSWORD_AUTH=true

# Turns a chat runs at once when people send them in multitask mode (default 3). 1 turns multitask off.
# COOPROMPT_MAX_PARALLEL_TURNS=3

# Shortest time, in minutes, between two runs of an automation (default 15). Lower it only to try them out.
# COOPROMPT_AUTOMATION_MIN_INTERVAL=15

# Google sign-in: in Google Cloud → Google Auth Platform → Clients, create an OAuth client of type
# "Desktop app" (no redirect URIs needed); set Audience to "Internal" so only your organization's
# accounts can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only Google Workspace accounts of these domains may sign in (comma separated).
GOOGLE_ALLOWED_DOMAINS=

# Optional: zip of CooPrompt.app served at /install (defaults to the latest build in apps/desktop/release,
# as named by its latest-mac.json). Set its version too so installed apps offer it as an update.
# COOPROMPT_INSTALLER_ZIP=
# COOPROMPT_INSTALLER_VERSION=0.1.1
